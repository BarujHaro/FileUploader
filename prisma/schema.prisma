
//npx prisma migrate dev --name init

//El bloque "generator" Este define como se creará el cliente de prisma que usarás en el código de Node
// Define que el cliente será para JavaScript/TypeScript
  // 'output' indica dónde se guardará físicamente el código generado.

generator client {
  provider = "prisma-client-js"
}


// El bloque "datasource" define la conexión real a tu base de datos física
datasource db {
  provider = "postgresql"   // Indica que estás usando PostgreSQL
  url      = env("DATABASE_URL")          // Lee la credencial de conexión desde un archivo .env
}




//El bloque "model" define la estructura de una tabla en la base de datos

model User {
  id       Int      @id @default(autoincrement())     // Clave primaria, número entero que aumenta solo
  username String   @unique                           // Nombre de usuario
  password String
  folders  Folder[]                                   //Relacionaes dice a prisma que el usuario puede tener una lista de carpetas y archivos
  files    File[]
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  
  // Relación con Usuario
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  // Sistema de carpetas anidadas 
  parent    Folder?  @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  Folder[] @relation("Subfolders")

  // Archivos dentro de la carpeta
  files     File[]

  shareLink      String?   @unique // UUID que irá en la URL compartida
  shareExpiresAt DateTime? // Fecha y hora límite en la que el enlace dejará de funcionar
}

model File {
  id        Int      @id @default(autoincrement())
  name      String
  url       String   // URL de  del algun lugar donde se guarden
  size      Int      // Tamaño en bytes
  mimeType  String   // ej. "application/pdf" o "image/png"
  createdAt DateTime @default(now())

  folder    Folder   @relation(fields: [folderId], references: [id])
  folderId  Int

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}