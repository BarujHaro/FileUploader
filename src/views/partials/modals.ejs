
    <!--Modal 1: Create new folder-->
    <div id="folderModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Create New Folder</h3>
            <form action="/folder/folders" method="POST">
                <input type="hidden" name="parentId" value="<%= typeof currentFolder !== 'undefined' && currentFolder ? currentFolder.id : '' %>">

                <div class="label-control">
                    <label for="folderName">Name of the Folder</label>
                    <input type="text" id="folderName" name="name" required placeholder="Ej. Doc, photo...">      
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('folderModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>

    <!--Modal 2: upload file-->
    <div id="uploadModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Upload Files</h3>
            <form action="/file/files/upload" method="POST" enctype="multipart/form-data">
                
                <!-- Guardar dentro de la carpeta actual si estamos dentro de una -->
                <input type="hidden" name="folderId" value="<%= typeof currentFolder !== 'undefined' && currentFolder ? currentFolder.id : '' %>">

                <!--Select folder-->
                    <div class="form-group">
                        <label for="folderSelect">Destination folder:</label>
                        <select id="folderSelect" name="folderId">
                            <option value="">Root</option>
                                <% if (typeof allFolders !== 'undefined' && allFolders) { %>
                                    <% allFolders.forEach(folder => { %>
                                        <option value="<%= folder.id %>" <%= (typeof currentFolder !== 'undefined' && currentFolder && currentFolder.id === folder.id) ? 'selected' : '' %>>
                                            <%= folder.name %>
                                        </option>
                                    <% }) %>
                                <% } %>
                        </select>
                    </div>

                <div class="form-group">
                    <label for="fileInput">Select file:</label>
                    <input type="file" id="fileInput" name="file" required>
                </div>

                <!--Select file-->
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('uploadModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal 3: To edit folder/file -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Edit</h3>
            <form id="editForm" method="POST">
                <div class="label-control">
                    <label for="editName">New name:</label>
                    <input type="text" id="editName" name="name" required>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

<!-- Modal 4: To preview file-->
    <div id="previewModal" class="modal-overlay">
        <div class="modal-content preview-content">
            <div class="preview-header">
                <h3 id="previewTitle">Preview</h3>
                <button type="button" class="icons cross-icon" onclick="closeModal('previewModal')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="35" height="35" fill="currentColor"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M504.6 148.5C515.9 134.9 514.1 114.7 500.5 103.4C486.9 92.1 466.7 93.9 455.4 107.5L320 270L184.6 107.5C173.3 93.9 153.1 92.1 139.5 103.4C125.9 114.7 124.1 134.9 135.4 148.5L278.3 320L135.4 491.5C124.1 505.1 125.9 525.3 139.5 536.6C153.1 547.9 173.3 546.1 184.6 532.5L320 370L455.4 532.5C466.7 546.1 486.9 547.9 500.5 536.6C514.1 525.3 515.9 505.1 504.6 491.5L361.7 320L504.6 148.5z"/></svg>
                </button>

            </div>
            <div id="previewBody" class="preview-body">
            <!-- El contenido dinámico (img, iframe, etc.) se inyectará aquí con JS -->
            </div>
        </div>
    </div>

<!-- Modal 5: To share-->
    <div id="shareModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Share</h3>
            <form id="shareForm" action="" method="POST">
                <div class="form-group">
                    <label for="durationName">Link Duration:</label>
                    <select name="duration" id="duration">
                        <option value="1h">1 Hour</option>
                        <option value="2h">2 Hour</option>
                        <option value="3h">3 Hour</option>
                        <option value="4h">4 Hour</option>
                        <option value="5h">5 Hour</option>
                    </select>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('shareModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate</button>
                </div>
            </form>
        </div>
    </div>

<!--6: Modal with Successful sharing -->
<div id="shareSuccessModal" class="modal-overlay">
    <div class="modal-content">
        <h3>Link generated</h3>
        <p>Copy the next temporal link:</p>
        
        <div class="label-control">
            <input type="text" id="generatedLinkInput" readonly style="width: 100%; padding: 8px;">
        </div>

        <div class="modal-actions" style="margin-top: 15px;">
            <button type="button" class="btn btn-primary" onclick="copyGeneratedLink()">Copy</button>
            <button type="button" class="btn btn-secondary" onclick="closeModal('shareSuccessModal')">Close</button>
        </div>
    </div>
</div>



<!-- SCRIPT -->
    <script>
        function openModal(modalId){
            document.getElementById(modalId).classList.add('active');
        }

        function closeModal(modalId){
            document.getElementById(modalId).classList.remove('active');
        }

        function openEditModal(event, actionUrl, currentName) {
            if(event) event.stopPropagation();

            const form = document.getElementById('editForm');
            const input = document.getElementById('editName');
            
            form.action = actionUrl;  
            input.value = currentName;
            
            document.getElementById('editModal').classList.add('active');
        }

        function openPreviewModal(previewUrl, fileName) {
            const titleEl = document.getElementById('previewTitle');
            const bodyEl = document.getElementById('previewBody');
            
            titleEl.textContent = fileName;
            bodyEl.innerHTML = '<p class="loading-msg">Loading preview...</p>';
            
            
            const ext = fileName.split('.').pop().toLowerCase();

            // 1. Img
            if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext)) {
                bodyEl.innerHTML = `<img src="${previewUrl}" alt="${fileName}" class="preview-media-img" />`;
            } 
            // 2. PDFs y Documentos
            else if (ext === 'pdf') {
                bodyEl.innerHTML = `<iframe src="${previewUrl}" class="preview-media-frame"></iframe>`;
            } 
            // 3. Audio / Video
            else if (['mp4', 'webm'].includes(ext)) {
                bodyEl.innerHTML = `<video controls class="preview-media-video"><source src="${previewUrl}"></video>`;
            }
            else if (['mp3', 'wav', 'ogg'].includes(ext)) {
                bodyEl.innerHTML = `<audio controls><source src="${previewUrl}"></audio>`;
            }
            // 4. Archivos no soportados directamente en el navegador
            else {
                bodyEl.innerHTML = `
                    <div class="unsupported-preview">
                        <p>No hay vista previa disponible para este tipo de archivo.</p>
                        <a href="${previewUrl}" class="btn btn-primary" download>Descargar archivo</a>
                    </div>
                `;
            }

            document.getElementById('previewModal').classList.add('active');
        }

        function openShareModal(folderId) {
                const form = document.getElementById('shareForm');
                form.action = `/folder/share/${folderId}`;
                
                document.getElementById('shareModal').classList.add('active');
            }

            function copyGeneratedLink() {
            const input = document.getElementById('generatedLinkInput');
            input.select();
            navigator.clipboard.writeText(input.value);
            alert('¡Link copied!');
        }

        // Al cargar la página, revisamos si hay un shareLink en la URL
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const shareLink = urlParams.get('shareLink');

            if (shareLink) {
                
                document.getElementById('generatedLinkInput').value = shareLink;
               
                document.getElementById('shareSuccessModal').classList.add('active'); 
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        });

        window.onclick = function(event) {
            if (event.target.classList.contains('modal-overlay')) {
                event.target.classList.remove('active');
            }
        };
    </script>